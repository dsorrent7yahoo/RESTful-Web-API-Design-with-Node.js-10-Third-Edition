{
  "family": "chapter04-dynamo-db-backend",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "512",
  "memory": "1024",
  "executionRoleArn": "arn:aws:iam::<account-id>:role/ecsTaskExecutionRole",
  "taskRoleArn": "arn:aws:iam::<account-id>:role/chapter04-dynamo-db-backend-task-role",
  "containerDefinitions": [
    {
      "name": "dynamo-db-backend",
      "image": "<account-id>.dkr.ecr.<region>.amazonaws.com/chapter04-dynamo-db-backend:latest",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 4001,
          "hostPort": 4001,
          "protocol": "tcp"
        }
      ],
      "environment": [
        {
          "name": "NODE_ENV",
          "value": "production"
        },
        {
          "name": "PORT",
          "value": "4001"
        },
        {
          "name": "AWS_REGION",
          "value": "us-east-1"
        },
        {
          "name": "DYNAMODB_TABLE",
          "value": "medications"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/chapter04-dynamo-db-backend",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "ecs"
        }
      }
    }
  ]
}
