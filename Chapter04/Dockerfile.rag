# Dockerfile.rag — Combined RAG image: Preact frontend (nginx) + 5 FastAPI services (supervisor)
#
# Services started inside the container:
#   nginx            :80  — serves static SPA and reverse-proxies /api/* → uvicorn backends
#   rag-core         :4005  main.py          — Core RAG API  (embeddings / vector store)
#   pharmacist       :4006  pharmacist_review.py — Drug-Related Problem review
#   ehr-query        :4007  ehr_query.py         — EHR/medication query
#   diagnosis        :4008  diagnosis_support.py — GARMLE-G diagnosis support
#   config-api       :4009  config_api.py        — Config & doc browser
#
# Build (from Chapter04 root):
#   docker build -f Dockerfile.rag -t healthcare-rag:latest .
#
# Run:
#   docker run -d -p 80:80 \
#     -e OPENAI_API_KEY=sk-... \
#     -e JWT_SECRET=your-secret \
#     -e RAG_LLM_BACKEND=openai \
#     --name healthcare-rag \
#     healthcare-rag:latest

# ── Stage 1: Build the Preact/TypeScript frontend ─────────────────────────────
FROM node:20-slim AS frontend-build
WORKDIR /frontend
COPY rag-frontend/package*.json ./
RUN npm ci
COPY rag-frontend/ ./
RUN npm run build

# ── Stage 2: Python runtime + nginx + supervisord ─────────────────────────────
FROM python:3.12-slim

# OS packages: nginx, supervisor, C toolchain required by sentence-transformers
RUN apt-get update && apt-get install -y --no-install-recommends \
    nginx \
    supervisor \
    gcc \
    g++ \
    libgomp1 \
    && rm -rf /var/lib/apt/lists/*

# Python dependencies
# Install torch CPU-only FIRST so sentence-transformers doesn't pull the full
# CUDA stack (~2 GB of GPU libs we don't need on EC2 t3.medium / t3.large).
# pip sees torch is already satisfied and skips the CUDA wheels entirely.
WORKDIR /app
COPY rag-api/requirements.txt .
RUN pip install --no-cache-dir \
      torch --index-url https://download.pytorch.org/whl/cpu \
 && pip install --no-cache-dir -r requirements.txt

# Application code (excludes .env and __pycache__ via root .dockerignore)
COPY rag-api/ .

# Static frontend built in stage 1
COPY --from=frontend-build /frontend/dist /usr/share/nginx/html

# nginx config (removes default server block first)
RUN rm -f /etc/nginx/sites-enabled/default /etc/nginx/conf.d/default.conf
COPY nginx.rag.conf /etc/nginx/conf.d/rag.conf

# supervisord config
COPY supervisord.rag.conf /etc/supervisor/conf.d/rag.conf

# Create log dir for supervisor
RUN mkdir -p /var/log/rag

# ── Environment defaults (override at runtime via -e or docker-compose env:) ──
ENV RAG_EMBED_BACKEND=clinicalbert \
    RAG_VECTOR_BACKEND=memory \
    RAG_LLM_BACKEND=openai \
    RAG_MEMORY_STORE_PATH=/tmp/rag-memory-store.pkl \
    PORT=4005

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
  CMD python3 -c "import urllib.request; urllib.request.urlopen('http://localhost/health')" || exit 1

CMD ["/usr/bin/supervisord", "-n", "-c", "/etc/supervisor/conf.d/rag.conf"]
