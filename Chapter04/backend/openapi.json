{
  "openapi": "3.0.3",
  "info": {
    "title": "Chapter04 Medications Mongo API",
    "version": "1.0.0",
    "description": "# DyanamoDB Table Loader\n\nREST endpoints for MongoDB medications in Chapter04/backend."
  },
  "servers": [
    {
      "url": "http://localhost:4000"
    }
  ],
  "tags": [
    {
      "name": "Medications",
      "description": "Medication operations backed by MongoDB"
    }
  ],
  "paths": {
    "/medications/": {
      "get": {
        "tags": [
          "Medications"
        ],
        "summary": "Get all medications",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "example": 50
            }
          },
          {
            "name": "skip",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "example": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Medication array",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Medication"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Medications"
        ],
        "summary": "Create medication",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Medication"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created medication"
          }
        }
      }
    },
    "/medications/id/{id}": {
      "get": {
        "tags": [
          "Medications"
        ],
        "summary": "Get medication by Mongo id",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Medication document",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Medication"
                }
              }
            }
          },
          "404": {
            "description": "Not found"
          }
        }
      }
    },
    "/medications/patient/{patient}": {
      "get": {
        "tags": [
          "Medications"
        ],
        "summary": "Get medications by patient UUID",
        "parameters": [
          {
            "name": "patient",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Filtered medications",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Medication"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/medications/code/{code}": {
      "get": {
        "tags": [
          "Medications"
        ],
        "summary": "Get medications by code",
        "parameters": [
          {
            "name": "code",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Filtered medications",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Medication"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/medications/{id}": {
      "put": {
        "tags": [
          "Medications"
        ],
        "summary": "Update medication by Mongo id",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Medication"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated medication"
          },
          "404": {
            "description": "Not found"
          }
        }
      },
      "delete": {
        "tags": [
          "Medications"
        ],
        "summary": "Delete medication by Mongo id",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Delete status"
          },
          "404": {
            "description": "Not found"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Medication": {
        "type": "object",
        "properties": {
          "_id": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "start": {
            "type": "string",
            "format": "date-time"
          },
          "stop": {
            "type": "string",
            "format": "date-time"
          },
          "patient": {
            "type": "string"
          },
          "payer": {
            "type": "string"
          },
          "encounter": {
            "type": "string"
          },
          "code": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "baseCost": {
            "type": "number"
          },
          "payerCoverage": {
            "type": "number"
          },
          "dispenses": {
            "type": "number"
          },
          "totalCost": {
            "type": "number"
          },
          "reasonCode": {
            "type": "string"
          },
          "reasonDescription": {
            "type": "string"
          }
        }
      }
    }
  }
}