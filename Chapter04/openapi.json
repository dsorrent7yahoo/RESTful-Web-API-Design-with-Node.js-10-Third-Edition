{
  "openapi": "3.0.3",
  "info": {
    "title": "Chapter04 Catalog API",
    "version": "1.0.0",
    "description": "# DyanamoDB Table Loader\n\nREST and Mongo-backed catalog APIs in Chapter04."
  },
  "servers": [
    {
      "url": "http://localhost:3000"
    }
  ],
  "tags": [
    {
      "name": "Catalog",
      "description": "Catalog operations backed by MongoDB"
    }
  ],
  "paths": {
    "/catalog/": {
      "get": {
        "tags": [
          "Catalog"
        ],
        "summary": "Get all catalog items",
        "responses": {
          "200": {
            "description": "Array of catalog items",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/CatalogItem"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Catalog"
        ],
        "summary": "Create a catalog item",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CatalogItem"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Created item"
          }
        }
      },
      "put": {
        "tags": [
          "Catalog"
        ],
        "summary": "Update a catalog item",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CatalogItem"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated item"
          }
        }
      }
    },
    "/catalog/item/{itemId}": {
      "get": {
        "tags": [
          "Catalog"
        ],
        "summary": "Get an item by itemId",
        "parameters": [
          {
            "name": "itemId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Catalog item",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CatalogItem"
                }
              }
            }
          },
          "404": {
            "description": "Item not found"
          }
        }
      },
      "delete": {
        "tags": [
          "Catalog"
        ],
        "summary": "Delete item by itemId",
        "parameters": [
          {
            "name": "itemId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Delete status"
          },
          "404": {
            "description": "Item not found"
          }
        }
      }
    },
    "/catalog/{categoryId}": {
      "get": {
        "tags": [
          "Catalog"
        ],
        "summary": "Get catalog items by category",
        "parameters": [
          {
            "name": "categoryId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Filtered items",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/CatalogItem"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CatalogItem": {
        "type": "object",
        "properties": {
          "itemId": {
            "type": "string"
          },
          "itemName": {
            "type": "string"
          },
          "price": {
            "type": "number"
          },
          "currency": {
            "type": "string"
          },
          "categories": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "itemId"
        ]
      }
    }
  }
}