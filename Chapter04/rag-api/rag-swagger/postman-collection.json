            },
            "description": "Generates DynamoDB PartiQL. patient_id optional.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"question\": \"Find patients on Warfarin prescribed after 2015 with cost over 100\",\n  \"mode\": \"sql\",\n  \"top_k\": 3\n}",
              "options": {
