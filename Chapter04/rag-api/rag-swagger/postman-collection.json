    {
      "name": "RAG \u2014 Query (WITH patient_id)",
      "description": "Standard query endpoints \u2014 include optional patient_id for PACE-RAG and index_filter for shard targeting.",
      "item": [
        {
          "name": "Standard Query \u2014 patient_id optional",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
