                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{RAG_BASE_URL}}/rag/query",
              "host": [
                "{{RAG_BASE_URL}}"
              ],
              "path": [
                "rag",
                "query"
              ]
            },
            "description": "GARMLE-G diagnosis with optional patient context.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"question\": \"Patient HbA1c 7.2%, on Metformin 500mg \\u2014 confirm diagnosis\",\n  \"mode\": \"diagnosis\",\n  \"top_k\": 5,\n  \"index_filter\": \"loinc\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        }
