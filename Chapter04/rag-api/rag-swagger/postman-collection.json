            "url": {
              "raw": "{{RAG_BASE_URL}}/rag/query",
              "host": [
                "{{RAG_BASE_URL}}"
              ],
              "path": [
                "rag",
                "query"
              ]
            },
            "description": "Full query with optional patient context. Omit patient_id to query anonymously.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"question\": \"What is Metformin prescribed for?\",\n  \"mode\": \"standard\",\n  \"top_k\": 5\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "Patient-Aware Query (PACE-RAG)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{RAG_JWT}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{RAG_BASE_URL}}/rag/query",
              "host": [
                "{{RAG_BASE_URL}}"
              ],
              "path": [
                "rag",
                "query"
              ]
            },
            "description": "Set patient_id to load patient EHR context (medications, conditions, observations) from DynamoDB.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"question\": \"What medications should be avoided for this patient?\",\n  \"patient_id\": \"{{PATIENT_ID}}\",\n  \"mode\": \"copilot\",\n  \"top_k\": 5\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
