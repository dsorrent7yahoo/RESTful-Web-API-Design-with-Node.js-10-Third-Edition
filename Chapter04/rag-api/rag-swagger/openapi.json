    "/rag/models/{name}/promote": {
      "post": {
        "tags": [
          "Models"
        ],
        "summary": "Promote Model \u2014 Test Then Activate",
        "description": "Runs 3 built-in clinical test questions against the live `/rag/query/simple` endpoint and, if all answers pass, automatically activates this model as the default for `POST /rag/query`.\n\nIf any test fails, the model is **not** activated (HTTP 422 returned).\n\nTest questions: HbA1c normal range \u00b7 Metformin uses \u00b7 Blood pressure range.\n\nUse `PUT /{name}/activate` to force-promote without testing.",
        "operationId": "promote_model_rag_models__name__promote_post",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "name",
