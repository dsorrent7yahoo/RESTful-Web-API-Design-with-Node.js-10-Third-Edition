    "/rag/index/loinc": {
      "post": {
        "tags": [
          "RAG"
        ],
        "summary": "Index LOINC Observation Codes",
        "description": "Indexes LOINC codes with clinical names, units, and reference ranges. 16 common codes (vitals, CBC, metabolic panel) are always included from a built-in table \u2014 **no DynamoDB or external API required.**\n\nPass `loinc_csv_path` to index the full LOINC table (free download from loinc.org).",
        "operationId": "index_loinc_rag_index_loinc_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/IndexLOINCRequest"
