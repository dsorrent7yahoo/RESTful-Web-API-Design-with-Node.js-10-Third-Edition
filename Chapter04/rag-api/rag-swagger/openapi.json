      "post": {
        "tags": [
          "RAG"
        ],
        "summary": "Index SNOMED CT Conditions",
        "description": "Scans `conditions` DynamoDB table for SNOMED CT codes and indexes concept names + synonyms from the UMLS Metathesaurus API.\n\nRequires `UMLS_API_KEY` env var (free: https://uts.nlm.nih.gov/uts/signup-login).",
