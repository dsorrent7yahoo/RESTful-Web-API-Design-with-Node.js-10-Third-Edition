{
  "openapi": "3.1.0",
  "info": {
    "title": "Healthcare RAG API",
    "description": "Retrieval-Augmented Generation for clinical medication intelligence. Indexes medications, FDA labels, SNOMED, LOINC, and clinical guidelines. Research: Lewis 2020, PACE-RAG 2603.17356, REALM 2402.07016, EMERGE 2406.00036.",
    "version": "1.0.0"
  },
  "paths": {
    "/rag/query/simple": {
      "post": {
        "tags": [
          "RAG",
          "RAG \u2014 ID-Free"
        ],
        "summary": "Clinical Query (no patient ID)",
        "description": "Ask a clinical question **without** linking to a patient record or restricting\nto a specific index shard. All indexed corpora are searched.\n\nUse `POST /rag/query` when you also want patient-aware (PACE-RAG) retrieval.\n\n**Modes:** `standard` \u00b7 `copilot` \u00b7 `sql` \u00b7 `diagnosis`",
        "operationId": "rag_query_simple_rag_query_simple_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RAGQueryRequestSimple"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RAGQueryResponseSimple"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/rag/index/simple": {
      "post": {
        "tags": [
          "RAG",
          "RAG \u2014 ID-Free"
        ],
        "summary": "Index Default Corpus (no table ID required)",
        "description": "Trigger medication indexing using environment-variable defaults \u2014 no `table_name` or `patient_id` required.\n\nInternally calls `POST /rag/index/medications` with `table_name` from `DYNAMODB_TABLE` env var (default: `medications`).\n\nUse `POST /rag/index/medications` when you need to specify a custom table.",
        "operationId": "index_simple_rag_index_simple_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/IndexRequestSimple"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IndexJobResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/rag/query": {
      "post": {
        "tags": [
          "RAG"
        ],
        "summary": "Clinical RAG Query",
        "description": "Ask a clinical question answered from indexed corpora.\n\n**Modes:**\n- `standard` \u2014 direct grounded answer\n- `copilot` \u2014 PCNE Drug-Related Problem report (arXiv:2402.01741)\n- `sql` \u2014 natural language \u2192 DynamoDB PartiQL (arXiv:2603.05569)\n- `diagnosis` \u2014 CPG-grounded differential diagnosis (arXiv:2506.21615)\n\nSet `patient_id` to enable PACE-RAG patient-aware retrieval (arXiv:2603.17356).\n\n**index_filter values:** `medications` \u00b7 `fda-labels` \u00b7 `snomed` \u00b7 `loinc` \u00b7 `guidelines`",
        "operationId": "rag_query_rag_query_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RAGQueryRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RAGQueryResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/rag/index/medications": {
      "post": {
        "tags": [
          "RAG"
        ],
        "summary": "Index Medications Table",
        "description": "Scans DynamoDB `medications` table and embeds each record with ClinicalBERT.\n\n**`limit`** controls how many records to index (default 500 for fast demo; set to 0 for all 371 806 records \u2014 takes ~30 min on CPU).\n\nReturns 202 immediately. Poll `GET /rag/jobs/{job_id}` for live progress.",
        "operationId": "index_medications_rag_index_medications_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/IndexMedicationsRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IndexJobResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/rag/index/fda-labels": {
      "post": {
        "tags": [
          "RAG"
        ],
        "summary": "Index FDA Drug Labels",
        "description": "Fetches drug labels from `api.fda.gov/drug/label.json` for every unique drug description in the medications table. Indexes 8 label sections per drug.\n\nFree API \u2014 no key required (1 000 req/day). Set `FDA_API_KEY` env var for 120 000 req/day.",
        "operationId": "index_fda_rag_index_fda_labels_post",
        "requestBody": {
