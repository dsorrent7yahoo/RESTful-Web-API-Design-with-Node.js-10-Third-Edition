# ══ Healthcare RAG API — Environment Configuration ══════════════════════════
# Copy to .env and fill in your values.
# All RAG_* variables override defaults in config.py.

# ── Embedding backend ────────────────────────────────────────────────────────
# clinicalbert  Local CPU inference — HIPAA safe, no API key (default)
# openai        OpenAI text-embedding-3-small — requires OPENAI_API_KEY
# bedrock       Amazon Titan Embed v2 — requires AWS credentials
RAG_EMBED_BACKEND=clinicalbert
RAG_CLINICALBERT_MODEL=pritamdeka/S-PubMedBert-MS-MARCO

# ── Vector store backend ─────────────────────────────────────────────────────
# memory      In-process numpy store persisted to pickle (default, single node)
# opensearch  AWS OpenSearch Serverless (production recommended)
# pgvector    PostgreSQL + pgvector extension
RAG_VECTOR_BACKEND=memory
RAG_MEMORY_STORE_PATH=/tmp/rag-memory-store.pkl
#RAG_OPENSEARCH_URL=https://your-domain.us-east-1.aoss.amazonaws.com
#RAG_OPENSEARCH_INDEX=healthcare-rag
#RAG_PG_DSN=postgresql://user:pass@localhost/ragdb

# ── LLM generation backend ──────────────────────────────────────────────────
# openai    GPT-4o — requires OPENAI_API_KEY
# bedrock   AWS Bedrock — requires IAM permissions (see aws-iam-policy.json)
# ollama    Local Llama-3.1-8B — privacy-preserving, no API key
RAG_LLM_BACKEND=bedrock

# Bedrock model IDs — NOVA models use direct ID, CLAUDE requires inference profile prefix
# Nova Pro  (on-demand, no prefix needed):  amazon.nova-pro-v1:0
# Nova Lite (on-demand, no prefix needed):  amazon.nova-lite-v1:0
# Claude Sonnet 4.6 (MUST use us. prefix):  us.anthropic.claude-sonnet-4-6
# Claude Haiku 4.5  (MUST use us. prefix):  us.anthropic.claude-haiku-4-5-20251001-v1:0
# Claude Sonnet 4   (MUST use us. prefix):  us.anthropic.claude-sonnet-4-20250514-v1:0
# See full list in aws-bedrock-models-ref.json
RAG_LLM_MODEL=amazon.nova-pro-v1:0

# OpenAI (if RAG_LLM_BACKEND=openai or RAG_EMBED_BACKEND=openai)
#OPENAI_API_KEY=sk-...

# Ollama (if RAG_LLM_BACKEND=ollama)
#RAG_OLLAMA_URL=http://localhost:11434

# ── Retrieval tuning ─────────────────────────────────────────────────────────
RAG_TOP_K=5
RAG_ALPHA=0.6        # 0=BM25 only, 1=dense only, 0.6=hybrid (recommended)
RAG_CHUNK_SIZE=400
RAG_CHUNK_OVERLAP=50

# ── External corpus API keys ─────────────────────────────────────────────────
# UMLS API — SNOMED CT indexing (free: https://uts.nlm.nih.gov/uts/signup-login)
#UMLS_API_KEY=your-umls-api-key

# FDA API — drug label indexing (free: https://open.fda.gov/apis/authentication/)
# Without key: 1,000 req/day. With key: 120,000 req/day.
#FDA_API_KEY=your-fda-api-key

# ── AWS configuration ────────────────────────────────────────────────────────
# Credentials from ~/.aws/credentials or instance profile — do NOT put keys here
AWS_REGION=us-east-1
DYNAMODB_TABLE=medications
STAGING_BUCKET=dgs-glue-staging

# Required IAM actions (see aws-iam-policy.json for the full policy):
#   bedrock-runtime:InvokeModel          — LLM generation
#   bedrock-runtime:InvokeModelWithResponseStream
#   bedrock:ListFoundationModels         — model discovery
#   bedrock:ListInferenceProfiles        — profile resolution
#   dynamodb:Scan                        — corpus indexing
#   dynamodb:GetItem                     — patient context loading
#   dynamodb:DescribeTable               — table validation
#   s3:GetObject, s3:PutObject           — guideline cache (optional)

# ── JWT (must match Flask/Django backend JWT_SECRET) ─────────────────────────
JWT_SECRET=healthcare-local-dev-secret

# ── Service ──────────────────────────────────────────────────────────────────
PORT=4005
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:5177,http://localhost:5176,http://localhost:8080

# ── Use-case API URLs (for pharmacist_review.py, ehr_query.py, diagnosis_support.py) ──
# These 3 APIs proxy to the core RAG API at PORT above
RAG_URL=http://localhost:4005        # core RAG API base URL (used by use-case APIs)
#RAG_JWT=                            # JWT token from POST /login — used by use-case APIs
                                     # to authenticate against /rag/query endpoints
                                     # Generate with: python -c "import jwt,time; print(jwt.encode({'sub':'admin','role':'admin','iat':int(time.time()),'exp':int(time.time())+7200,'scopes':[]}, 'healthcare-local-dev-secret', algorithm='HS256'))"

# Use-case API service ports (each starts a separate uvicorn instance)
# PHARMACIST_PORT=4006               # pharmacist_review.py  — DRP reviews
# EHR_QUERY_PORT=4007                # ehr_query.py          — NL to PartiQL
# DIAGNOSIS_PORT=4008                # diagnosis_support.py  — GARMLE-G diagnosis

# Swagger UIs for use-case APIs:
#   http://localhost:4006/docs  — Pharmacist Review
#   http://localhost:4007/docs  — EHR Natural Language Query
#   http://localhost:4008/docs  — Diagnosis Support
#   rag-swagger/index-pharmacist.html  — static, no server needed
#   rag-swagger/index-ehr-query.html   — static, no server needed
#   rag-swagger/index-diagnosis.html   — static, no server needed